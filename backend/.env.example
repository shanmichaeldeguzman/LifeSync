# ---- LifeSync API configuration ----
# Copy to .env for local development. Never commit the real .env file.

# Runtime
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# Comma-separated list of allowed browser origins (frontend URLs).
# Capacitor apps use https://localhost (Android) and capacitor://localhost (iOS).
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,https://localhost,capacitor://localhost

# Supabase project (Project Settings -> API)
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Public anon / publishable key: safe for browsers, protected by RLS.
SUPABASE_ANON_KEY=your-anon-key
# SECRET service-role key. Server-side only. Used solely for account deletion.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
