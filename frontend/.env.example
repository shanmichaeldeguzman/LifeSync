# LifeSync frontend configuration (PUBLIC values only).
# Copy to frontend/.env for local development. On Vercel/Netlify set these as
# environment variables; scripts/set-env.mjs bakes them into the build.

LIFESYNC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The anon / publishable key is safe in browsers (RLS protects all data).
LIFESYNC_SUPABASE_ANON_KEY=your-anon-key
LIFESYNC_API_URL=http://localhost:3000/api
LIFESYNC_APP_URL=http://localhost:8100
