{
  "name": "lifesync-app",
  "version": "1.0.0",
  "author": "LifeSync",
  "scripts": {
    "config": "node scripts/set-env.mjs && node scripts/gen-icons.mjs",
    "prestart": "npm run config",
    "start": "ng serve",
    "prebuild": "npm run config",
    "build": "ng build",
    "build:android": "npm run build && npx cap sync android",
    "watch": "ng build --watch --configuration development",
    "lint": "ng lint",
    "typecheck": "npm run config && tsc -p tsconfig.app.json --noEmit",
    "test": "npm run config && ng test --no-watch",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@angular/service-worker": "^22.2.4",
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/keyboard": "8.0.6",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/network": "^8.0.1",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "8.0.4",
    "@ionic/angular": "^9.0.0",
    "@supabase/supabase-js": "^2.119.0",
    "chart.js": "^4.6.1",
    "dexie": "^4.4.7",
    "dompurify": "^3.4.17",
    "ionicons": "^8.1.0",
    "marked": "^16.4.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@angular/language-service": "22.2.4",
    "@capacitor/cli": "8.6.0",
    "@ionic/angular-toolkit": "^13.0.0",
    "@ionic/eslint-config": "^0.5.0",
    "@ionic/prettier-config": "^4.0.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.6",
    "angular-eslint": "22.6.0",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "^5.1.0"
  },
  "prettier": "@ionic/prettier-config",
  "description": "LifeSync: all-in-one personal organizer (Ionic + Angular + Capacitor)"
}
